# SUMMARY: SHACL shapes, i.e. rules the RDF graph must obey (D-013, D-038).
# pyshacl checks these after every build. They cover only the parts of the
# graph pyshacl can see: it cannot read RDF-star annotations (finding F12),
# so "every annotation has a source" is checked by a SPARQL query instead
# (src/seisa_kg/rdf/checks/annotation_without_origin.rq).

# The SHACL vocabulary, used to write the rules.
PREFIX sh:   <http://www.w3.org/ns/shacl#>
# Our own vocabulary.
PREFIX ex:   <https://seisa-kg.example/def/>
# XML Schema datatypes, e.g. dateTime.
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
# The W3C provenance vocabulary.
PREFIX prov: <http://www.w3.org/ns/prov#>

# Check 1: every legal entity has at least one legal name.
ex:LegalEntityShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:LegalEntity.
    sh:targetClass ex:LegalEntity ;
    # It must have one or more ex:legalName values.
    sh:property [ sh:path ex:legalName ; sh:minCount 1 ] .

# Check 2: every source record says which source, which address and when, exactly once each.
ex:SourceRecordShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:SourceRecord.
    sh:targetClass ex:SourceRecord ;
    # Exactly one source (e.g. ex:GLEIF).
    sh:property [ sh:path ex:source ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Exactly one web address.
    sh:property [ sh:path ex:url ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Exactly one fetch time, which must be a proper date and time.
    sh:property [ sh:path ex:retrievedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

# Check 3: every scope decision has all its parts, exactly once each (D-036).
ex:ScopeDecisionShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:ScopeDecision.
    sh:targetClass ex:ScopeDecision ;
    # Exactly one entity it is about.
    sh:property [ sh:path ex:entity ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Exactly one sponsor.
    sh:property [ sh:path ex:sponsor ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Exactly one verdict, and it must be one of the three allowed values.
    sh:property [ sh:path ex:verdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( ex:In ex:Review ex:Out ) ] ;
    # Exactly one reason, in words.
    sh:property [ sh:path ex:reason ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Exactly one rule that made it.
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ] .

# --- Companies House and news shapes (19 Oct; schema sections 9 and 10) ---

# Check 5: every Stake belongs to exactly one company and names its controller (D-075).
ex:StakeShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:Stake.
    sh:targetClass ex:Stake ;
    # Exactly one company it is a stake in.
    sh:property [ sh:path ex:company ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # At least one controller name, as given.
    sh:property [ sh:path ex:holderName ; sh:minCount 1 ] .

# Check 6: every Appointment is at exactly one company and has a role (D-077).
ex:AppointmentShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:Appointment.
    sh:targetClass ex:Appointment ;
    # Exactly one company.
    sh:property [ sh:path ex:company ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # At least one role, as given.
    sh:property [ sh:path ex:role ; sh:minCount 1 ] .

# Check 7: every Person has a name (D-074).
ex:PersonShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:Person.
    sh:targetClass ex:Person ;
    # At least one name, as given.
    sh:property [ sh:path ex:name ; sh:minCount 1 ] .

# Check 8: every Release has one title and one sponsor whose website it came from (D-079).
ex:ReleaseShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:Release.
    sh:targetClass ex:Release ;
    # Exactly one title.
    sh:property [ sh:path ex:title ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Exactly one sponsor.
    sh:property [ sh:path ex:publishedBy ; sh:minCount 1 ; sh:maxCount 1 ] .

# Check 9: every Deal comes from exactly one release and has a target and a kind, even if "unknown" (D-083, D-090).
ex:DealShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:Deal.
    sh:targetClass ex:Deal ;
    # Exactly one release.
    sh:property [ sh:path ex:announcedIn ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # At least one target name.
    sh:property [ sh:path ex:targetName ; sh:minCount 1 ] ;
    # At least one kind.
    sh:property [ sh:path ex:dealKind ; sh:minCount 1 ] .

# Check 10: every FundClose comes from exactly one release and names its fund (D-083).
ex:FundCloseShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:FundClose.
    sh:targetClass ex:FundClose ;
    # Exactly one release.
    sh:property [ sh:path ex:announcedIn ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # At least one fund name.
    sh:property [ sh:path ex:fundName ; sh:minCount 1 ] .

# Check 11: every Match node (entity matching, D-108) has one name as written, one known outcome and one reason,
# and a sameEntityAs or refersToGroup link only to a single node.
ex:MatchShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:Match.
    sh:targetClass ex:Match ;
    # Exactly one name, as the release wrote it.
    sh:property [ sh:path ex:nameAsWritten ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # Exactly one outcome, from the fixed list (D-099).
    sh:property [ sh:path ex:outcome ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "sameEntityAs" "refersToGroup" "ambiguous" "news-only" "out-of-scope" "non-entity" "unresolved" ) ] ;
    # Exactly one reason.
    sh:property [ sh:path ex:reason ; sh:minCount 1 ; sh:maxCount 1 ] ;
    # At most one same-entity link (the strict rule, D-098).
    sh:property [ sh:path ex:sameEntityAs ; sh:maxCount 1 ] ;
    # At most one group link.
    sh:property [ sh:path ex:refersToGroup ; sh:maxCount 1 ] .

# Check 12: every NewsOnlyCompany (D-109) has at least one name, and is named by at least one Match.
ex:NewsOnlyCompanyShape a sh:NodeShape ;
    # Apply this rule to everything typed ex:NewsOnlyCompany.
    sh:targetClass ex:NewsOnlyCompany ;
    # At least one name, as a release wrote it.
    sh:property [ sh:path ex:name ; sh:minCount 1 ] ;
    # At least one Match points to it (followed backwards).
    sh:property [ sh:path [ sh:inversePath ex:namedCompany ] ; sh:minCount 1 ] .

