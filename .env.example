# SUMMARY: A template listing the secret settings the project needs.
# Copy this file to `.env` and fill in the real values. `.env` is never
# saved to git, so the real keys stay on your machine only.

# The language-model API key Seisa provides. Has a spending limit; never share it.
LLM_API_KEY=
# Your free Companies House API key, from developer.company-information.service.gov.uk.
COMPANIES_HOUSE_API_KEY=
# Where the local Neo4j Desktop database listens for connections.
NEO4J_URI=bolt://localhost:7687
# The Neo4j username (Neo4j Desktop's default is "neo4j").
NEO4J_USER=neo4j
# The Neo4j password you chose when creating the database.
NEO4J_PASSWORD=
